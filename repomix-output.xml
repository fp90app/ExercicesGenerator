      }
    }
    // --- AUTRES MODES ---
    else if (mode === 'SURVIVAL_PLAY') {
      setGameConfig({ modeId: id });
      setView('SURVIVAL_GAME');
    }
    else if (mode === 'CHRONO') {
      setView('CHRONO');
    }
    else if (mode === 'SURVIVAL') {
      setActiveTab('SURVIVAL');
    }
    else if (mode === 'TABLES_ALL') {
