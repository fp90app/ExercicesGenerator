};
// =========================================================
// 1. COMPOSANT PRINCIPAL (Le "Routeur" Intelligent)
// =========================================================
const StandardGame = (props) => {
    const { user, config, onFinish, onBack, onSound } = props;
    const [showBugReport, setShowBugReport] = useState(false);
    const getDebugContext = () => {
        if (!questionData) return null;
        return {
            exerciseId: config.id,
            level: config.level,
            // On capture les variables aléatoires (ex: a=3, b=5)
            variables: questionData.scope || {},
            correctAnswer: questionData.correctAnswer || questionData.correct,
            questionText: questionData.question,
            userLastAnswer: userAnswer
        };
    };
