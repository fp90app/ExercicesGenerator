                                                ? (
                                                    // LOGIQUE DE CORRECTION
                                                    // On recalcule la justesse ici pour déterminer la couleur
                                                    (() => {
                                                        const userValClean = String(val).trim().toLowerCase().replace(',', '.');
                                                        const correctValClean = String(q.correct).trim().toLowerCase();
                                                        let isCorrect = false;
