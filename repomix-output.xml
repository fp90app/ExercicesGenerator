            correct = "Isocèle";
            options = ["Isocèle", "Équilatéral", "Rectangle", "Quelconque"];
            codings = [{ type: 'tick', indices: [0, 1] }, { type: 'tick', indices: [0, 2] }];
            explanation = "Il a deux côtés de même longueur.";
        }
