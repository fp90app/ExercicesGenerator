                { type: 'tick', indices: [0, 1] }, { type: 'tick', indices: [1, 2] },
                { type: 'tick', indices: [2, 3] }, { type: 'tick', indices: [3, 0] },
                { type: 'right_angle', indices: [0, 1, 2] }
