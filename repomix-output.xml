        <MuteButton muted={muted} toggle={() => setMuted(!muted)} />
        {/* Panneau Admin Secret */}
        {view === 'ADMIN_SECRET' && <AdminPanel user={user} onBack={() => setView('ADMIN')} />}
        {/* Dashboard Professeur */}
        {view === 'ADMIN' && (
          <TeacherDashboard
            user={user}
            onLogout={() => { logout(); setView('LOGIN'); setAuthMode('LANDING'); }}
