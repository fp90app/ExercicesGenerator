            qText = "Quelle est la nature de ce triangle ?";
            correct = "Équilatéral";
            options = ["Isocèle", "Équilatéral", "Rectangle", "Rectangle isocèle"];
            codings = [
                { type: 'tick', indices: [0, 1] }, { type: 'tick', indices: [1, 2] }, { type: 'tick', indices: [2, 0] }
